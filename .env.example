# ---- Kalisoft AI Sales Pipeline (FastAPI) ----
# Copy to .env for local development. Never commit the real .env.

ENV=development
SECRET_KEY=replace-with-a-random-64-character-hex-secret
AUTH_DEV_MODE=true
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Google Sign-In (OAuth Web client ID) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_ALLOWED_DOMAINS=kalisoftai.com

# --- Google Cloud / GCS ---
GOOGLE_CLOUD_PROJECT=your-project-id
GCS_BUCKET_CONTACTS=kalisoftai-datahub
GCS_PATH_CONTACTS=all-sales-contacts-data
# Application Default Credentials are used automatically on Cloud Run.

# --- Database ---
# Local Postgres:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sales_pipeline
# Cloud SQL (unix socket):
# CLOUD_SQL_CONNECTION_NAME=project:asia-south1:instance
# POSTGRES_DB=sales_pipeline
# POSTGRES_USER=sales
# POSTGRES_PASSWORD=change-me
# If nothing is set, the app falls back to local SQLite (sales_pipeline.db).

# --- Redis (cron queue / voice cache) ---
REDIS_URL=redis://localhost:6379/0

# --- SMTP / IMAP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=

# --- AI (Gemma / Gemini) ---
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it

# --- WhatsApp Cloud API ---
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Wechaty gateway (WhatsApp/WeChat via Node service) ---
WHATSAPP_ENABLED=false
WECHATY_GATEWAY_URL=http://localhost:8788
WECHATY_GATEWAY_TOKEN=
WECHATY_WEBHOOK_SECRET=
WECHATY_TIMEOUT_SECONDS=15

# --- LinkedIn / Reddit ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_ENABLED=false

# --- Data governance ---
GOVERNANCE_ENABLED=true
PII_REDACTION_ENABLED=true
AUDIT_LOG_ENABLED=true
RETENTION_DAYS_AUDIT=365
RETENTION_DAYS_CONTACTS=730

# --- Cost-optimised SLM routing ---
# Local small models (Ollama) handle cheap tasks; cloud models are the fallback
# and are used only for MEDIUM/LARGE tiers.
LLM_ENABLED=false
LLM_LOCAL_BASE_URL=http://localhost:11434
LLM_LOCAL_NANO_MODEL=qwen2.5:0.5b
LLM_LOCAL_MODEL=qwen2.5:3b
LLM_LOCAL_MEDIUM_MODEL=llama3.1:8b
LLM_CLOUD_FLASH_MODEL=gemini-2.0-flash
LLM_CLOUD_MODEL=gemini-2.5-pro
LLM_GEMMA_MODEL=gemma-4-27b-it
LLM_MONTHLY_TOKEN_BUDGET=5000000
LLM_ENFORCE_BUDGET=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARS=20000
LLM_MAX_OUTPUT_CHARS=40000
