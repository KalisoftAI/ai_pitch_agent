# --- Kalisoft Wechaty Gateway ---
# mock (no Wechat account, deterministic) or live (real puppet)
WECHATY_GATEWAY_MODE=mock
WECHATY_GATEWAY_HOST=0.0.0.0
WECHATY_GATEWAY_PORT=8788

# Shared secret the FastAPI service must send as X-Gateway-Token / Bearer.
WECHATY_GATEWAY_TOKEN=change-me-gateway-token

# Where inbound messages are POSTed (FastAPI webhook).
WECHATY_WEBHOOK_URL=http://localhost:8000/api/whatsapp/webhook
WECHATY_WEBHOOK_SECRET=change-me-webhook-secret

# Live mode puppet selection
WECHATY_PUPPET=wechaty-puppet-wechat4u
# For hosted/iPad puppets (wechaty-puppet-service):
# WECHATY_PUPPET=wechaty-puppet-service
# WECHATY_PUPPET_SERVICE_TOKEN=your-token
