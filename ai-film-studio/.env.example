# AI Film Studio - local configuration
APP_NAME="AI Film Studio"
APP_MODE=development          # development | live
MOCK_AI=true                  # true = zero-cost deterministic AI responses
SEED_SAMPLE_DATA=true         # seed sample projects and topics on first start
RENDER_MODE=motion            # motion | ffmpeg | simulated
DATABASE_URL=sqlite:///./storage/ai_film_studio.db
STORAGE_DIR=./storage
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rendering
FFMPEG_BIN=ffmpeg
PREVIEW_WIDTH=640
PREVIEW_HEIGHT=360
EXPORT_WIDTH=1280
EXPORT_HEIGHT=720

# Motion renderer (Node 20+, Chrome or Edge, FFmpeg)
MOTION_RENDERER_DIR=./renderer
MOTION_CHROME_PATH=            # optional; blank = auto-detect Chrome/Edge
MOTION_FPS=24
MOTION_WORKERS=2
MOTION_TIMEOUT_SECONDS=3600
MOTION_AI_DIRECTION=true       # skipped automatically when MOCK_AI=true
MOTION_AI_TIMEOUT_SECONDS=25
MOTION_FALLBACK_TO_CARDS=true  # false = fail instead of using the card renderer
MOTION_AUDIO=true              # procedural cues + loudness-normalised mix
MOTION_AUDIO_SR=48000
MOTION_EFFECTS=grain,vignette,particles

# Cloud storage (Application Default Credentials)
GCS_ENABLED=false
GCS_BUCKET=sales-crm
GCS_PREFIX=marketing-videos
GCS_PROJECT=
GCS_AUTO_PUBLISH=true
GCS_TIMEOUT_SECONDS=60

# Local Gemma 4 via llama.cpp server (OpenAI compatible)
GEMMA_MODEL_ID=gemma-4-12b-it-qat-q4_0
GEMMA_BASE_URL=http://127.0.0.1:8081/v1
GEMMA_API_KEY=local
GEMMA_MODEL_PATH=./storage/models/gemma-4-12b-it-qat-q4_0/gemma-4-12b-it-qat-q4_0.gguf

# Gemini (live mode only)
GEMINI_API_KEY=
GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Claude (live mode only)
ANTHROPIC_API_KEY=
CLAUDE_OPUS_MODEL=claude-opus-4-5

# Routing
AI_CACHE_TTL_SECONDS=3600
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_RETRIES=2
AI_MONTHLY_BUDGET_USD=25
